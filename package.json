{
  "name": "omoi",
  "version": "0.1.0",
  "description": "Static site and build system for omoi",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "new": "node scripts/new.ts",
    "release": "node scripts/release.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lemon-gith/omoi.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/lemon-gith/omoi/issues"
  },
  "homepage": "https://github.com/lemon-gith/omoi#readme",
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.9",
    "astro": "^7.4.12",
    "diff": "^9.0.0",
    "github-slugger": "^2.0.0",
    "hastscript": "^9.0.3",
    "katex": "^0.19.1",
    "mdast-util-to-hast": "^13.2.2",
    "mdast-util-to-string": "^4.0.0",
    "pagefind": "^1.6.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-math": "^6.0.0",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "private": true,
  "type": "module"
