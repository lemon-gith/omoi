---
/**
 * A redirect page for a static host: GitHub Pages cannot send HTTP redirects,
 * so an alias URL is a tiny page that forwards to the real one.
 * Without JS the meta refresh does it; with JS the query and hash survive too.
 */
import { SITE } from '../../site.config.ts';

interface Props {
  to: string;
}
const { to } = Astro.props;
const abs = new URL(to, SITE.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting to {to}</title>
    <link rel="canonical" href={abs} />
    <meta name="robots" content="noindex" />
    <script is:inline define:vars={{ to }}>
      location.replace(to + location.search + location.hash);
    </script>
    <meta http-equiv="refresh" content={`0; url=${to}`} />
  </head>
  <body>
    <p>This page lives at <a href={to}>{abs}</a>.</p>
  </body>
</html>
